{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ukemi",
  "version": "0.0.0",
  "identifier": "dev.ukemi.app",
  "build": {
    "beforeDevCommand": "npm run vite --workspace @ukemi/desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run vite:build --workspace @ukemi/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ukemi",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "copyright": "Ukemi contributors",
    "shortDescription": "A desktop GUI for Jujutsu",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
